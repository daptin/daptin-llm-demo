# Daptin server
DAPTIN_BASE_URL=http://localhost:6336
DAPTIN_API_URL=http://localhost:6336

# Daptin admin credentials (for setup script)
DAPTIN_ADMIN_EMAIL=admin@example.com
DAPTIN_ADMIN_PASSWORD=replace-with-a-long-random-password

# LLM provider to configure during setup
LLM_PROVIDER_TYPE=openai
LLM_PROVIDER_NAME=openai-primary
LLM_PUBLIC_MODEL=assistant
LLM_UPSTREAM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...
LLM_BASE_URL=
LLM_OPERATIONS=["chat"]
LLM_CAPABILITIES={"tools":true}

# Demo server
LISTEN_HOST=127.0.0.1
LISTEN_PORT=7777
